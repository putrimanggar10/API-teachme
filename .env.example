# Contoh konfigurasi TeachMe. sslmode=disable HANYA untuk latihan lokal.
# Nilai ini TIDAK dibaca otomatis; set manual di terminal (lihat README).
# Karakter '#' pada password harus ditulis %23 di dalam URL.
DATABASE_URL=postgres://postgres:GANTI_PASSWORD%23@localhost:5432/teachme?sslmode=disable
PORT=8099
JWT_SECRET=ganti-dengan-secret-acak-yang-panjang
